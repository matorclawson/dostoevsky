{
 "about": "A backup opens with the same records and checkpoint. An existing destination is refused: an empty directory and a regular file. For the empty directory Go's own os.Rename also refuses, so removing the engine's check is not detected by that step (it is when the rename is made with the raw system call); the regular file detects it either way, because the rename then fails with another error.",
 "covers": [
  "825a794"
 ],
 "formats": [
  "legacy",
  "segmented"
 ],
 "steps": [
  {
   "do": "open"
  },
  {
   "do": "publish_many",
   "start": 0,
   "count": 30,
   "ids": true
  },
  {
   "do": "commit_batch",
   "group": "g",
   "offset": 0,
   "next": 7,
   "state": "seven"
  },
  {
   "do": "snapshot",
   "as": "source",
   "groups": [
    "g"
   ]
  },
  {
   "do": "make_dir",
   "file": "taken"
  },
  {
   "do": "make_file",
   "file": "occupied",
   "content": "x"
  },
  {
   "do": "remember_bytes",
   "file": "occupied",
   "as": "occupied"
  },
  {
   "do": "backup",
   "dest": "$root/occupied",
   "error": "exists"
  },
  {
   "do": "bytes_unchanged",
   "file": "occupied",
   "as": "occupied"
  },
  {
   "do": "backup",
   "dest": "$root/taken",
   "error": "exists"
  },
  {
   "do": "absent",
   "file": "taken/*"
  },
  {
   "do": "absent",
   "file": "taken/.*"
  },
  {
   "do": "absent",
   "file": ".*.backup-*"
  },
  {
   "do": "backup",
   "dest": "$root/copy"
  },
  {
   "do": "absent",
   "file": ".*.backup-*"
  },
  {
   "do": "close"
  },
  {
   "do": "switch"
  },
  {
   "do": "open",
   "dir": "$root/copy",
   "segmented": false
  },
  {
   "do": "same",
   "as": "source",
   "groups": [
    "g"
   ]
  }
 ]
}
