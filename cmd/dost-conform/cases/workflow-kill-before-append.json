{
 "about": "A process killed at workflow.before_append: the operation is absent after reopening.",
 "covers": [],
 "formats": [
  "workflow"
 ],
 "steps": [
  {
   "do": "wf_open",
   "dir": "$root/start"
  },
  {
   "do": "wf_register",
   "name": "work",
   "version": 1,
   "steps": [
    {
     "kind": "activity",
     "name": "send"
    }
   ]
  },
  {
   "do": "mark",
   "file": "start/segments/seg-*.log",
   "as": "start-base"
  },
  {
   "do": "remember_bytes",
   "file": "start/journal.v1",
   "as": "start-witness"
  },
  {
   "do": "arm",
   "point": "workflow.before_append",
   "kill": true,
   "skip": 0
  },
  {
   "do": "wf_start_once",
   "run": "r",
   "name": "work",
   "version": 1,
   "queue": "q",
   "input": "0",
   "dies": true
  },
  {
   "do": "switch"
  },
  {
   "do": "mark",
   "file": "start/segments/seg-*.log",
   "as": "start-killed"
  },
  {
   "do": "bytes_unchanged",
   "file": "start/journal.v1",
   "as": "start-witness"
  },
  {
   "do": "compare",
   "marks": [
    "start-killed",
    "start-base"
   ],
   "is": "equal"
  },
  {
   "do": "wf_open",
   "dir": "$root/start"
  },
  {
   "do": "wf_history",
   "run": "r",
   "after": 0,
   "limit": 100,
   "expect": {
    "kinds": []
   }
  },
  {
   "do": "wf_start_once",
   "run": "r",
   "name": "work",
   "version": 1,
   "queue": "q",
   "input": "0",
   "expect": {
    "created": true
   }
  },
  {
   "do": "wf_close"
  },
  {
   "do": "wf_open",
   "dir": "$root/poll"
  },
  {
   "do": "wf_register",
   "name": "work",
   "version": 1,
   "steps": [
    {
     "kind": "activity",
     "name": "send"
    }
   ]
  },
  {
   "do": "wf_start_once",
   "run": "r",
   "name": "work",
   "version": 1,
   "queue": "q",
   "input": "0"
  },
  {
   "do": "mark",
   "file": "poll/segments/seg-*.log",
   "as": "poll-base"
  },
  {
   "do": "remember_bytes",
   "file": "poll/journal.v1",
   "as": "poll-witness"
  },
  {
   "do": "arm",
   "point": "workflow.before_append",
   "kill": true,
   "skip": 0
  },
  {
   "do": "wf_poll",
   "queue": "q",
   "lease_ms": 60000,
   "dies": true
  },
  {
   "do": "switch"
  },
  {
   "do": "mark",
   "file": "poll/segments/seg-*.log",
   "as": "poll-killed"
  },
  {
   "do": "bytes_unchanged",
   "file": "poll/journal.v1",
   "as": "poll-witness"
  },
  {
   "do": "compare",
   "marks": [
    "poll-killed",
    "poll-base"
   ],
   "is": "equal"
  },
  {
   "do": "wf_open",
   "dir": "$root/poll"
  },
  {
   "do": "wf_history",
   "run": "r",
   "after": 0,
   "limit": 100,
   "expect": {
    "kinds": [
     "WorkflowStarted",
     "ActivityScheduled"
    ]
   }
  },
  {
   "do": "wf_poll",
   "queue": "q",
   "lease_ms": 60000,
   "expect": {
    "task": {
     "attempt": 1
    }
   }
  },
  {
   "do": "wf_close"
  },
  {
   "do": "wf_open",
   "dir": "$root/finish"
  },
  {
   "do": "wf_register",
   "name": "work",
   "version": 1,
   "steps": [
    {
     "kind": "activity",
     "name": "send",
     "attempts": 2
    }
   ]
  },
  {
   "do": "wf_start_once",
   "run": "r",
   "name": "work",
   "version": 1,
   "queue": "q",
   "input": "0"
  },
  {
   "do": "wf_poll",
   "queue": "q",
   "lease_ms": 60000,
   "save": {
    "t": "task.token"
   }
  },
  {
   "do": "mark",
   "file": "finish/segments/seg-*.log",
   "as": "finish-base"
  },
  {
   "do": "remember_bytes",
   "file": "finish/journal.v1",
   "as": "finish-witness"
  },
  {
   "do": "arm",
   "point": "workflow.before_append",
   "kill": true,
   "skip": 0
  },
  {
   "do": "wf_finish",
   "run": "r",
   "token": "$t",
   "value": "1",
   "dies": true
  },
  {
   "do": "switch"
  },
  {
   "do": "mark",
   "file": "finish/segments/seg-*.log",
   "as": "finish-killed"
  },
  {
   "do": "bytes_unchanged",
   "file": "finish/journal.v1",
   "as": "finish-witness"
  },
  {
   "do": "compare",
   "marks": [
    "finish-killed",
    "finish-base"
   ],
   "is": "equal"
  },
  {
   "do": "wf_open",
   "dir": "$root/finish"
  },
  {
   "do": "wf_history",
   "run": "r",
   "after": 0,
   "limit": 100,
   "expect": {
    "kinds": [
     "WorkflowStarted",
     "ActivityScheduled",
     "ActivityStarted"
    ]
   }
  },
  {
   "do": "wf_finish",
   "run": "r",
   "token": "$t",
   "value": "1"
  },
  {
   "do": "wf_history",
   "run": "r",
   "after": 0,
   "limit": 100,
   "expect": {
    "kinds": [
     "WorkflowStarted",
     "ActivityScheduled",
     "ActivityStarted",
     "ActivityCompleted",
     "WorkflowCompleted"
    ]
   }
  },
  {
   "do": "wf_close"
  },
  {
   "do": "wf_open",
   "dir": "$root/failure"
  },
  {
   "do": "wf_register",
   "name": "work",
   "version": 1,
   "steps": [
    {
     "kind": "activity",
     "name": "send",
     "attempts": 2
    }
   ]
  },
  {
   "do": "wf_start_once",
   "run": "r",
   "name": "work",
   "version": 1,
   "queue": "q",
   "input": "0"
  },
  {
   "do": "wf_poll",
   "queue": "q",
   "lease_ms": 60000,
   "save": {
    "t": "task.token"
   }
  },
  {
   "do": "mark",
   "file": "failure/segments/seg-*.log",
   "as": "failure-base"
  },
  {
   "do": "remember_bytes",
   "file": "failure/journal.v1",
   "as": "failure-witness"
  },
  {
   "do": "arm",
   "point": "workflow.before_append",
   "kill": true,
   "skip": 0
  },
  {
   "do": "wf_finish",
   "run": "r",
   "token": "$t",
   "failure": "busy",
   "dies": true
  },
  {
   "do": "switch"
  },
  {
   "do": "mark",
   "file": "failure/segments/seg-*.log",
   "as": "failure-killed"
  },
  {
   "do": "bytes_unchanged",
   "file": "failure/journal.v1",
   "as": "failure-witness"
  },
  {
   "do": "compare",
   "marks": [
    "failure-killed",
    "failure-base"
   ],
   "is": "equal"
  },
  {
   "do": "wf_open",
   "dir": "$root/failure"
  },
  {
   "do": "wf_history",
   "run": "r",
   "after": 0,
   "limit": 100,
   "expect": {
    "kinds": [
     "WorkflowStarted",
     "ActivityScheduled",
     "ActivityStarted"
    ]
   }
  },
  {
   "do": "wf_finish",
   "run": "r",
   "token": "$t",
   "failure": "busy"
  },
  {
   "do": "wf_history",
   "run": "r",
   "after": 0,
   "limit": 100,
   "expect": {
    "kinds": [
     "WorkflowStarted",
     "ActivityScheduled",
     "ActivityStarted",
     "ActivityFailed",
     "RetryScheduled"
    ]
   }
  },
  {
   "do": "wf_close"
  },
  {
   "do": "wf_open",
   "dir": "$root/expiry"
  },
  {
   "do": "wf_register",
   "name": "work",
   "version": 1,
   "steps": [
    {
     "kind": "activity",
     "name": "send"
    }
   ]
  },
  {
   "do": "wf_start_once",
   "run": "r",
   "name": "work",
   "version": 1,
   "queue": "q",
   "input": "0"
  },
  {
   "do": "wf_poll",
   "queue": "q",
   "lease_ms": 100
  },
  {
   "do": "sleep_ms",
   "ms": 200
  },
  {
   "do": "mark",
   "file": "expiry/segments/seg-*.log",
   "as": "expiry-base"
  },
  {
   "do": "remember_bytes",
   "file": "expiry/journal.v1",
   "as": "expiry-witness"
  },
  {
   "do": "arm",
   "point": "workflow.before_append",
   "kill": true,
   "skip": 0
  },
  {
   "do": "wf_poll",
   "queue": "q",
   "lease_ms": 60000,
   "dies": true
  },
  {
   "do": "switch"
  },
  {
   "do": "mark",
   "file": "expiry/segments/seg-*.log",
   "as": "expiry-killed"
  },
  {
   "do": "bytes_unchanged",
   "file": "expiry/journal.v1",
   "as": "expiry-witness"
  },
  {
   "do": "compare",
   "marks": [
    "expiry-killed",
    "expiry-base"
   ],
   "is": "equal"
  },
  {
   "do": "wf_open",
   "dir": "$root/expiry"
  },
  {
   "do": "wf_history",
   "run": "r",
   "after": 0,
   "limit": 100,
   "expect": {
    "kinds": [
     "WorkflowStarted",
     "ActivityScheduled",
     "ActivityStarted"
    ]
   }
  },
  {
   "do": "wf_poll",
   "queue": "q",
   "lease_ms": 60000,
   "expect": {
    "task": null
   }
  },
  {
   "do": "wf_history",
   "run": "r",
   "after": 0,
   "limit": 100,
   "expect": {
    "kinds": [
     "WorkflowStarted",
     "ActivityScheduled",
     "ActivityStarted",
     "ActivityTimedOut",
     "WorkflowFailed"
    ]
   }
  },
  {
   "do": "wf_close"
  },
  {
   "do": "wf_open",
   "dir": "$root/signal"
  },
  {
   "do": "wf_register",
   "name": "work",
   "version": 1,
   "steps": [
    {
     "kind": "signal",
     "name": "go"
    },
    {
     "kind": "activity",
     "name": "send"
    }
   ]
  },
  {
   "do": "wf_start_once",
   "run": "r",
   "name": "work",
   "version": 1,
   "queue": "q",
   "input": "0"
  },
  {
   "do": "mark",
   "file": "signal/segments/seg-*.log",
   "as": "signal-base"
  },
  {
   "do": "remember_bytes",
   "file": "signal/journal.v1",
   "as": "signal-witness"
  },
  {
   "do": "arm",
   "point": "workflow.before_append",
   "kill": true,
   "skip": 0
  },
  {
   "do": "wf_signal",
   "run": "r",
   "step": 0,
   "name": "go",
   "value": "5",
   "dies": true
  },
  {
   "do": "switch"
  },
  {
   "do": "mark",
   "file": "signal/segments/seg-*.log",
   "as": "signal-killed"
  },
  {
   "do": "bytes_unchanged",
   "file": "signal/journal.v1",
   "as": "signal-witness"
  },
  {
   "do": "compare",
   "marks": [
    "signal-killed",
    "signal-base"
   ],
   "is": "equal"
  },
  {
   "do": "wf_open",
   "dir": "$root/signal"
  },
  {
   "do": "wf_history",
   "run": "r",
   "after": 0,
   "limit": 100,
   "expect": {
    "kinds": [
     "WorkflowStarted",
     "SignalWaiting"
    ]
   }
  },
  {
   "do": "wf_signal",
   "run": "r",
   "step": 0,
   "name": "go",
   "value": "5"
  },
  {
   "do": "wf_history",
   "run": "r",
   "after": 0,
   "limit": 100,
   "expect": {
    "kinds": [
     "WorkflowStarted",
     "SignalWaiting",
     "SignalReceived",
     "ActivityScheduled"
    ]
   }
  },
  {
   "do": "wf_close"
  }
 ]
}
