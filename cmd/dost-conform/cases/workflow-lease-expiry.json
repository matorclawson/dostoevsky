{
 "about": "A live lease survives reopening; an expired one fails a single-attempt run and retries another.",
 "covers": [],
 "formats": [
  "workflow"
 ],
 "steps": [
  {
   "do": "wf_open"
  },
  {
   "do": "wf_register",
   "name": "once",
   "version": 1,
   "steps": [
    {
     "kind": "activity",
     "name": "send"
    }
   ]
  },
  {
   "do": "wf_register",
   "name": "twice",
   "version": 1,
   "steps": [
    {
     "kind": "activity",
     "name": "send",
     "attempts": 2
    }
   ]
  },
  {
   "do": "wf_start_once",
   "run": "a",
   "name": "once",
   "version": 1,
   "queue": "qa",
   "input": "0"
  },
  {
   "do": "wf_start_once",
   "run": "b",
   "name": "twice",
   "version": 1,
   "queue": "qb",
   "input": "0"
  },
  {
   "do": "wf_start_once",
   "run": "c",
   "name": "once",
   "version": 1,
   "queue": "qc",
   "input": "0"
  },
  {
   "do": "wf_poll",
   "queue": "qa",
   "lease_ms": 100,
   "expect": {
    "task": {
     "run": "a",
     "attempt": 1,
     "input": "0"
    }
   },
   "save": {
    "ta": "task.token"
   }
  },
  {
   "do": "wf_poll",
   "queue": "qb",
   "lease_ms": 100,
   "expect": {
    "task": {
     "run": "b",
     "attempt": 1
    }
   }
  },
  {
   "do": "wf_poll",
   "queue": "qc",
   "lease_ms": 60000,
   "expect": {
    "task": {
     "run": "c",
     "attempt": 1
    }
   }
  },
  {
   "do": "switch"
  },
  {
   "do": "wf_open"
  },
  {
   "do": "wf_poll",
   "queue": "qc",
   "lease_ms": 60000,
   "expect": {
    "task": null
   }
  },
  {
   "do": "sleep_ms",
   "ms": 200
  },
  {
   "do": "wf_finish",
   "run": "a",
   "token": "$ta",
   "value": "1",
   "error": "stale"
  },
  {
   "do": "wf_poll",
   "queue": "qa",
   "lease_ms": 60000,
   "expect": {
    "task": null
   }
  },
  {
   "do": "wf_poll",
   "queue": "qb",
   "lease_ms": 60000,
   "expect": {
    "task": {
     "run": "b",
     "attempt": 2
    }
   }
  },
  {
   "do": "wf_history",
   "run": "a",
   "after": 0,
   "limit": 100,
   "expect": {
    "kinds": [
     "WorkflowStarted",
     "ActivityScheduled",
     "ActivityStarted",
     "ActivityTimedOut",
     "WorkflowFailed"
    ]
   }
  },
  {
   "do": "wf_history",
   "run": "b",
   "after": 0,
   "limit": 100,
   "expect": {
    "kinds": [
     "WorkflowStarted",
     "ActivityScheduled",
     "ActivityStarted",
     "ActivityTimedOut",
     "RetryScheduled",
     "ActivityStarted"
    ]
   }
  },
  {
   "do": "wf_history",
   "run": "c",
   "after": 0,
   "limit": 100,
   "expect": {
    "kinds": [
     "WorkflowStarted",
     "ActivityScheduled",
     "ActivityStarted"
    ]
   }
  }
 ]
}
