{
 "about": "Everything acknowledged is there after the process is killed.",
 "covers": [],
 "formats": [
  "workflow"
 ],
 "steps": [
  {
   "do": "wf_open"
  },
  {
   "do": "wf_register",
   "name": "work",
   "version": 1,
   "steps": [
    {
     "kind": "activity",
     "name": "send"
    },
    {
     "kind": "signal",
     "name": "go"
    },
    {
     "kind": "activity",
     "name": "done"
    }
   ]
  },
  {
   "do": "wf_start_once",
   "run": "held",
   "name": "work",
   "version": 1,
   "queue": "qh",
   "input": "0"
  },
  {
   "do": "wf_start_once",
   "run": "waiting",
   "name": "work",
   "version": 1,
   "queue": "qw",
   "input": "0"
  },
  {
   "do": "wf_poll",
   "queue": "qh",
   "lease_ms": 60000,
   "save": {
    "h": "task.token"
   }
  },
  {
   "do": "wf_poll",
   "queue": "qw",
   "lease_ms": 60000,
   "save": {
    "w": "task.token"
   }
  },
  {
   "do": "wf_finish",
   "run": "waiting",
   "token": "$w",
   "value": "1"
  },
  {
   "do": "wf_snapshot",
   "as": "acked",
   "runs": [
    "held",
    "waiting"
   ]
  },
  {
   "do": "kill"
  },
  {
   "do": "switch"
  },
  {
   "do": "wf_open"
  },
  {
   "do": "same",
   "as": "acked"
  },
  {
   "do": "wf_finish",
   "run": "held",
   "token": "$h",
   "value": "1"
  },
  {
   "do": "wf_signal",
   "run": "waiting",
   "step": 1,
   "name": "go",
   "value": "5"
  },
  {
   "do": "wf_poll",
   "queue": "qw",
   "lease_ms": 60000,
   "expect": {
    "task": {
     "activity": "done",
     "input": "5"
    }
   }
  }
 ]
}
