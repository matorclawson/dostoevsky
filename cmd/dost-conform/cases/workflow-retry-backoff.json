{
 "about": "A retry is not granted before its backoff has passed.",
 "covers": [],
 "formats": [
  "workflow"
 ],
 "steps": [
  {
   "do": "wf_open"
  },
  {
   "do": "wf_register",
   "name": "slow",
   "version": 1,
   "steps": [
    {
     "kind": "activity",
     "name": "send",
     "attempts": 2,
     "backoff_ms": 3000
    }
   ]
  },
  {
   "do": "wf_start_once",
   "run": "r",
   "name": "slow",
   "version": 1,
   "queue": "q",
   "input": "0"
  },
  {
   "do": "wf_poll",
   "queue": "q",
   "lease_ms": 100,
   "expect": {
    "task": {
     "attempt": 1
    }
   }
  },
  {
   "do": "sleep_ms",
   "ms": 200
  },
  {
   "do": "wf_poll",
   "queue": "q",
   "lease_ms": 60000,
   "expect": {
    "task": null
   }
  },
  {
   "do": "wf_history",
   "run": "r",
   "after": 0,
   "limit": 100,
   "expect": {
    "kinds": [
     "WorkflowStarted",
     "ActivityScheduled",
     "ActivityStarted",
     "ActivityTimedOut",
     "RetryScheduled"
    ]
   }
  },
  {
   "do": "switch"
  },
  {
   "do": "wf_open"
  },
  {
   "do": "wf_poll",
   "queue": "q",
   "lease_ms": 60000,
   "expect": {
    "task": null
   }
  },
  {
   "do": "sleep_ms",
   "ms": 3100
  },
  {
   "do": "wf_poll",
   "queue": "q",
   "lease_ms": 60000,
   "expect": {
    "task": {
     "attempt": 2
    }
   }
  }
 ]
}
